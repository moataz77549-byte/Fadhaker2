# ==============================================================================
# Fadhkur (فذكر) — Environment Variables Matrix
# ==============================================================================

# --- FIREBASE SERVER-SIDE CREDENTIALS (SUPABASE SECRETS / BACKEND ONLY) ---
# NEVER expose these values to Android, Web, APK/AAB, logs, CI artifacts, or Git.
# If a service-account private key is ever shared outside the secret manager,
# revoke that key in Google Cloud IAM and create a replacement.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- FIREBASE CLIENT-SIDE IDENTIFIERS (PUBLIC APP CONFIG ONLY) ---
FIREBASE_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FCM_VAPID_KEY=

# --- PLATFORM CONFIGURATION ---
ANDROID_PACKAGE_NAME=app.fadhkur
IOS_BUNDLE_ID=app.fadhkur

# --- SUPABASE CONFIGURATION ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=

# --- APPLICATION RUNTIME ---
APP_ENV=development
API_BASE_URL=
ALLOWED_ORIGINS=http://localhost:3000
